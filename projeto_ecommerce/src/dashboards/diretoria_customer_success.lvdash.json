{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Carteira de clientes (gold.clientes_segmentacao)",
      "queryLines": [
        "SELECT\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  concat(\n",
        "    CASE segmento_cliente WHEN 'VIP' THEN '1' WHEN 'TOP_TIER' THEN '2' ELSE '3' END,\n",
        "    '. ', segmento_cliente\n",
        "  ) AS segmento_ordenado,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ranking_receita,\n",
        "  primeira_compra,\n",
        "  ultima_compra,\n",
        "  date_format(ultima_compra, 'dd/MM/yyyy') AS ultima_compra_texto\n",
        "FROM clientes_segmentacao"
      ],
      "columns": [
        {
          "displayName": "Clientes",
          "description": "Clientes distintos no recorte. A carteira tem 50 clientes e a tabela inclui quem nunca comprou (receita 0), se houver.",
          "expression": "COUNT(DISTINCT `id_cliente`)"
        },
        {
          "displayName": "Clientes VIP",
          "description": "Clientes do segmento VIP, ou seja com receita a partir de R$ 22.000 no periodo. Sao 10 na carteira atual.",
          "expression": "COUNT(DISTINCT CASE WHEN `segmento_cliente` = 'VIP' THEN `id_cliente` END)"
        },
        {
          "displayName": "Clientes sem compra",
          "description": "Clientes com total_compras = 0, o publico de ativacao do CS. Hoje vale ZERO: todos os 50 clientes da carteira compraram no periodo. O KPI fica no dashboard como monitor -- se subir, apareceu cliente cadastrado que nunca comprou.",
          "expression": "COUNT(DISTINCT CASE WHEN `total_compras` = 0 THEN `id_cliente` END)"
        },
        {
          "displayName": "Receita",
          "description": "Receita total dos clientes do recorte, em reais (R$). Fecha em R$ 974.077,28 para a carteira inteira, igual a receita da empresa no periodo.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Compras",
          "description": "Soma das vendas dos clientes do recorte. Para a carteira inteira da 3.020, o mesmo total de vendas da empresa.",
          "expression": "SUM(`total_compras`)"
        },
        {
          "displayName": "Ticket medio",
          "description": "Valor medio de UMA compra, em reais (R$). Calculo: receita dividida pelo numero de compras -- NUNCA a media da coluna ticket_medio, que seria media de medias e ainda e nula para quem nunca comprou. Carteira inteira: R$ 322,54.",
          "expression": "SUM(`receita`) / NULLIF(SUM(`total_compras`), 0)"
        },
        {
          "displayName": "Receita por cliente",
          "description": "Receita dividida pelo numero de clientes do recorte, em reais (R$). Mede o valor de um cliente, nao de uma compra. Serve para comparar regioes de tamanhos diferentes: uma regiao pode faturar menos no total e ter cliente mais valioso.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `id_cliente`)"
        }
      ]
    },
    {
      "name": "ds_vip_share",
      "displayName": "Participacao dos VIP na receita, sempre do periodo completo",
      "queryLines": [
        "SELECT\n",
        "  SUM(CASE WHEN segmento_cliente = 'VIP' THEN receita ELSE 0 END)\n",
        "    / SUM(receita) AS receita_vip_pct\n",
        "FROM clientes_segmentacao"
      ]
    }
  ],
