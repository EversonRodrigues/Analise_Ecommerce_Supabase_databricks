{
  "datasets": [
    {
      "name": "ds_clientes",
      "displayName": "Carteira de clientes (gold.clientes_segmentacao)",
      "queryLines": [
        "SELECT\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ranking_receita,\n",
        "  primeira_compra,\n",
        "  ultima_compra,\n",
        "  date_format(ultima_compra, 'dd/MM/yyyy') AS ultima_compra_texto\n",
        "FROM clientes_segmentacao"
      ],
      "columns": [
        {
          "displayName": "Clientes",
          "description": "Clientes distintos no recorte. A carteira tem 50 clientes e a tabela inclui quem nunca comprou (receita 0), se houver.",
          "expression": "COUNT(DISTINCT `id_cliente`)"
        },
        {
          "displayName": "Clientes VIP",
          "description": "Clientes do segmento VIP, ou seja, com receita a partir de R$ 22.000 no período. São 10 na carteira atual.",
          "expression": "COUNT(DISTINCT CASE WHEN `segmento_cliente` = 'VIP' THEN `id_cliente` END)"
        },
        {
          "displayName": "Clientes sem compra",
          "description": "Clientes com total_compras = 0, o público de ativação do CS. Hoje vale **zero**: todos os 50 clientes da carteira compraram no período. O KPI fica no dashboard como monitor — se subir, apareceu cliente cadastrado que nunca comprou.",
          "expression": "COUNT(DISTINCT CASE WHEN `total_compras` = 0 THEN `id_cliente` END)"
        },
        {
          "displayName": "Receita total",
          "description": "Receita total dos clientes do recorte, em reais (R$). Fecha em R$ 974.077,28 para a carteira inteira, igual à receita da empresa no período.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Compras",
          "description": "Soma das vendas dos clientes do recorte. Para a carteira inteira dá 3.020, o mesmo total de vendas da empresa.",
          "expression": "SUM(`total_compras`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Valor médio de **uma** compra, em reais (R$). Cálculo: receita dividida pelo número de compras — nunca a média da coluna ticket_medio, que seria média de médias e ainda é nula para quem nunca comprou. Carteira inteira: R$ 322,54.",
          "expression": "SUM(`receita`) / NULLIF(SUM(`total_compras`), 0)"
        },
        {
          "displayName": "Receita por cliente",
          "description": "Receita dividida pelo número de clientes do recorte, em reais (R$). Mede o valor de um cliente, não de uma compra. Serve para comparar regiões de tamanhos diferentes: uma região pode faturar menos no total e ter cliente mais valioso.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `id_cliente`)"
        }
      ]
    },
    {
      "name": "ds_vip_share",
      "displayName": "Participação dos VIP na receita, sempre do período completo",
      "queryLines": [
        "SELECT\n",
        "  SUM(CASE WHEN segmento_cliente = 'VIP' THEN receita ELSE 0 END)\n",
        "    / SUM(receita) AS receita_vip_pct\n",
        "FROM clientes_segmentacao"
      ]
    }
  ],
