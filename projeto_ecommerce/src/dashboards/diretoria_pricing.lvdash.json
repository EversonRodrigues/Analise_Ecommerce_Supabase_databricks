{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Competitividade de preço por produto (gold.precos_competitividade)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  preco_maximo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media,\n",
        "  diferenca_pct_vs_minimo,\n",
        "  classificacao_preco,\n",
        "  possui_preco_suspeito,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  receita,\n",
        "  itens_vendidos\n",
        "FROM precos_competitividade"
      ],
      "columns": [
        {
          "displayName": "Produtos monitorados",
          "description": "Produtos distintos com pelo menos uma cotação de concorrente, contados por id_produto. São 215 no total. Atenção: não é o catálogo inteiro nem o número de produtos vendidos (205) — são populações diferentes.",
          "expression": "COUNT(DISTINCT `id_produto`)"
        },
        {
          "displayName": "Mais caros que todos (confirmados)",
          "description": "Produtos acima do **maior** preço de todos os concorrentes, excluindo os que têm cotação suspeita. São 20 dos 35 classificados como MAIS_CARO_QUE_TODOS. O recorte \"sem suspeitos\" está dentro da measure de propósito: vale mesmo que você mexa nos filtros.",
          "expression": "COUNT(DISTINCT CASE WHEN `classificacao_preco` = 'MAIS_CARO_QUE_TODOS' AND NOT `possui_preco_suspeito` THEN `id_produto` END)"
        },
        {
          "displayName": "Receita dos mais caros confirmados",
          "description": "Receita, em reais (R$), dos produtos confirmadamente mais caros que todos os concorrentes: R$ 161.375,09. É a receita que fica exposta se um concorrente ficar agressivo. Não é a receita da empresa.",
          "expression": "SUM(CASE WHEN `classificacao_preco` = 'MAIS_CARO_QUE_TODOS' AND NOT `possui_preco_suspeito` THEN `receita` ELSE 0 END)"
        },
        {
          "displayName": "Produtos com preço suspeito",
          "description": "Produtos com pelo menos uma cotação de concorrente abaixo de 60% do nosso preço. São 15, todos da categoria Tênis. O alerta é sobre a **confiança** no dado coletado, não sobre a validade do número: confirme a cotação na origem antes de mexer em preço.",
          "expression": "COUNT(DISTINCT CASE WHEN `possui_preco_suspeito` THEN `id_produto` END)"
        },
        {
          "displayName": "Diferença média vs mercado (confirmados)",
          "description": "Média da diferença entre o nosso preço e a média dos concorrentes, **só** dos produtos sem cotação suspeita. Dividida por 100 porque a coluna da gold está em pontos percentuais (10 = 10%) e o formato de porcentagem multiplica por 100. Positivo = estamos mais caros. Categoria sem nenhum produto confirmado (Tênis) não aparece.",
          "expression": "AVG(CASE WHEN NOT `possui_preco_suspeito` THEN `diferenca_pct_vs_media` END) / 100"
        }
      ]
    },
    {
      "name": "ds_acao_mais_caros",
      "displayName": "Ação: produtos mais caros que todos os concorrentes",
      "queryLines": [
        "SELECT\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media,\n",
        "  diferenca_pct_vs_minimo,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  receita,\n",
        "  itens_vendidos\n",
        "FROM precos_competitividade\n",
        "WHERE classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "ORDER BY receita DESC"
      ]
    }
  ],
