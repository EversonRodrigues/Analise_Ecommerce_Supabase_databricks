{
  "datasets": [
    {
      "name": "ds_precos",
      "displayName": "Competitividade de preco por produto (gold.precos_competitividade)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  preco_maximo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media,\n",
        "  diferenca_pct_vs_minimo,\n",
        "  classificacao_preco,\n",
        "  possui_preco_suspeito,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  receita,\n",
        "  itens_vendidos\n",
        "FROM precos_competitividade"
      ],
      "columns": [
        {
          "displayName": "Produtos monitorados",
          "description": "Produtos distintos com pelo menos uma cotacao de concorrente, contados por id_produto. Sao 215 no total. ATENCAO: nao e o catalogo inteiro nem o numero de produtos vendidos (205) -- sao populacoes diferentes.",
          "expression": "COUNT(DISTINCT `id_produto`)"
        },
        {
          "displayName": "Mais caros que todos (confirmados)",
          "description": "Produtos acima do MAIOR preco de todos os concorrentes, excluindo os que tem cotacao suspeita. Sao 20 dos 35 classificados como MAIS_CARO_QUE_TODOS. O recorte \"sem suspeitos\" esta dentro da measure de proposito: vale mesmo que o usuario mexa nos filtros.",
          "expression": "COUNT(DISTINCT CASE WHEN `classificacao_preco` = 'MAIS_CARO_QUE_TODOS' AND NOT `possui_preco_suspeito` THEN `id_produto` END)"
        },
        {
          "displayName": "Receita dos mais caros confirmados",
          "description": "Receita, em reais (R$), dos produtos confirmadamente mais caros que todos os concorrentes: R$ 161.375,09. E a receita que fica exposta se um concorrente ficar agressivo. NAO e a receita da empresa.",
          "expression": "SUM(CASE WHEN `classificacao_preco` = 'MAIS_CARO_QUE_TODOS' AND NOT `possui_preco_suspeito` THEN `receita` ELSE 0 END)"
        },
        {
          "displayName": "Produtos com preco suspeito",
          "description": "Produtos com pelo menos uma cotacao de concorrente abaixo de 60% do nosso preco. Sao 15, todos da categoria Tênis. O alerta e sobre a CONFIANCA no dado coletado, nao sobre a validade do numero: confirme a cotacao na origem antes de mexer em preco.",
          "expression": "COUNT(DISTINCT CASE WHEN `possui_preco_suspeito` THEN `id_produto` END)"
        },
        {
          "displayName": "Diferenca media vs mercado (confirmados)",
          "description": "Media da diferenca entre o nosso preco e a media dos concorrentes, SO dos produtos sem cotacao suspeita. Dividida por 100 porque a coluna da gold esta em pontos percentuais (10 = 10%) e o formato de porcentagem multiplica por 100. Positivo = estamos mais caros. Categoria sem nenhum produto confirmado (Tênis) nao aparece.",
          "expression": "AVG(CASE WHEN NOT `possui_preco_suspeito` THEN `diferenca_pct_vs_media` END) / 100"
        }
      ]
    },
    {
      "name": "ds_acao_mais_caros",
      "displayName": "Acao: produtos mais caros que todos os concorrentes",
      "queryLines": [
        "SELECT\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_minimo_concorrentes,\n",
        "  total_concorrentes,\n",
        "  diferenca_pct_vs_media,\n",
        "  diferenca_pct_vs_minimo,\n",
        "  CASE WHEN possui_preco_suspeito THEN 'Sim' ELSE 'Não' END AS preco_a_confirmar,\n",
        "  receita,\n",
        "  itens_vendidos\n",
        "FROM precos_competitividade\n",
        "WHERE classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "ORDER BY receita DESC"
      ]
    }
  ],
