{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas no grão da venda (gold.vendas_detalhadas)",
      "queryLines": [
        "SELECT\n",
        "  id_venda,\n",
        "  data,\n",
        "  hora,\n",
        "  dia_semana,\n",
        "  CASE WHEN canal_venda = 'ecommerce' THEN 'E-commerce' ELSE 'Loja física' END AS canal,\n",
        "  categoria,\n",
        "  marca,\n",
        "  faixa_preco,\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  id_cliente,\n",
        "  estado,\n",
        "  regiao,\n",
        "  segmento_cliente,\n",
        "  quantidade,\n",
        "  receita\n",
        "FROM vendas_detalhadas"
      ],
      "columns": [
        {
          "displayName": "Receita total",
          "description": "Receita em reais (R$). Soma de quantidade × preco_unitario. Inclui as 20 vendas de produto não cadastrado (R$ 4.240,01): dinheiro que entrou é receita. A soma de toda a tabela fecha em R$ 974.077,28.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Vendas",
          "description": "Quantidade de vendas (pedidos). Uma linha da tabela é uma venda, então é uma contagem de id_venda, não de itens. Total do período: 3.020.",
          "expression": "COUNT(`id_venda`)"
        },
        {
          "displayName": "Ticket médio",
          "description": "Valor médio de **uma** venda, em reais (R$). Cálculo: receita total dividida pelo número de vendas — nunca média de médias. Total do período: R$ 322,54.",
          "expression": "SUM(`receita`) / COUNT(`id_venda`)"
        },
        {
          "displayName": "Itens vendidos",
          "description": "Soma das quantidades. Maior que o número de vendas, porque uma venda pode levar vários itens. Total do período: 4.322.",
          "expression": "SUM(`quantidade`)"
        },
        {
          "displayName": "Receita média por dia",
          "description": "Receita dividida pelo número de dias distintos do recorte, em reais (R$). Use esta measure para comparar dias da semana: o período tem 5 sábados e 5 domingos, mas só 4 de cada dia útil, então comparar pelo total premiaria o fim de semana só por ele ter um dia a mais.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `data`)"
        },
        {
          "displayName": "Produtos",
          "description": "Produtos distintos vendidos, contados por id_produto. Nome de produto não é único (55 nomes se repetem em 137 produtos), então contar por nome daria número menor e errado.",
          "expression": "COUNT(DISTINCT `id_produto`)"
        },
        {
          "displayName": "Clientes",
          "description": "Clientes distintos que compraram no recorte, contados por id_cliente. É uma contagem distinta, então não pode ser somada entre agrupamentos.",
          "expression": "COUNT(DISTINCT `id_cliente`)"
        }
      ]
    },
    {
      "name": "ds_top_produtos",
      "displayName": "Top 10 produtos por receita (gold.vendas_produtos)",
      "queryLines": [
        "SELECT\n",
        "  ranking_receita,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  total_vendas,\n",
        "  itens_vendidos,\n",
        "  receita,\n",
        "  ticket_medio,\n",
        "  ranking_na_categoria\n",
        "FROM vendas_produtos\n",
        "WHERE ranking_receita <= 10\n",
        "ORDER BY ranking_receita"
      ]
    },
    {
      "name": "ds_pareto_produtos",
      "displayName": "Concentração da receita por produto (gold.vendas_produtos)",
      "queryLines": [
        "SELECT\n",
        "  ranking_receita,\n",
        "  nome_produto,\n",
        "  receita,\n",
        "  SUM(receita) OVER (\n",
        "    ORDER BY receita DESC, id_produto\n",
        "    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n",
        "  ) / SUM(receita) OVER () AS receita_acumulada_pct\n",
        "FROM vendas_produtos\n",
        "QUALIFY ranking_receita <= 60\n",
        "ORDER BY ranking_receita"
      ]
    }
  ],
